@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "ROOT=%~dp0"
cd /d "%ROOT%" || exit /b 1

if not exist logs mkdir logs
set "LOG=%ROOT%logs\verify_fill.log"
set "INNER=%ROOT%run_verify_fill_3steps_inner.bat"

echo [INFO] ROOT=%ROOT%
echo [INFO] Logging to: %LOG%
echo [INFO] Started: %DATE% %TIME%
echo ============================================================>> "%LOG%"
echo Started: %DATE% %TIME%>> "%LOG%"
echo ROOT: %ROOT%>> "%LOG%"
echo ============================================================>> "%LOG%"

if not exist "%INNER%" (
  echo [ERROR] Missing "%INNER%"
  echo [ERROR] Create it and put the actual 3-step commands in it.
  echo [ERROR] (This wrapper only handles live console + log tee.)
  exit /b 2
)

call "%INNER%" 2>&1 | call "%ROOT%tools\tee.cmd" "%LOG%"

set "RC=%ERRORLEVEL%"
echo ============================================================>> "%LOG%"
echo Finished: %DATE% %TIME%  exit=%RC%>> "%LOG%"
echo ============================================================>> "%LOG%"

echo [DONE] exit=%RC%
exit /b %RC%
