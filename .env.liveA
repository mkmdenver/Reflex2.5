# ---- identity & ports ----
REFLEX__INSTANCE_ID=liveA
REFLEX__HUB_MODE=LIVE
REFLEX__SERVER__PORT=7000
REFLEX__EVAL__PORT=8000

# ---- storage ----
REFLEX__STORAGE__PG_DSN=postgresql://reflex:***@localhost:5432/reflex
REFLEX__STORAGE__PARQUET_ROOT=D:\reflex_parquet\instances\liveA

# ---- partitioning (DB-driven; no files) ----
REFLEX__HUB_PARTITIONS=1
REFLEX__HUB_INDEX=0

# ---- polygon (live) ----
POLYGON_KEY=YOUR_POLYGON_KEY
DROP_COPY_TICKS=1
DROP_COPY_QUOTES=0

# ---- quotes/NBBO knobs ----
NBBO_INTERVALS_ENABLE=1
NBBO_MAX_INTERVAL_MS=5000

# ---- telemetry ----
LOG_LEVEL=INFO
METRICS_ENABLE=1

# ---- trader (paper) ----
ALPACA_BASE=https://paper-api.alpaca.markets
ALPACA_KEY_ID=YOUR_KEY
ALPACA_SECRET_KEY=YOUR_SECRET
ACCOUNT_MAX_EQUITY=25000
ORDER_MAX_RISK_PCT=0.25
